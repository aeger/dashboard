# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dashboard data (production state — mount as volume)
/data/

# Credentials
credentials.json
token.json
Context/
app/favicon.ico.bak-*
public/header-banner.png.bak-*

# stale data backups (junk) — Wren 2026-06-28
*.stale-bak-*
data.stale-bak-*/

# Claude Code local state — Wren 2026-08-22
# Neither belongs in the repo, and the daily git-durability UNTRACKED finding on
# `.claude/` had gone unactioned for 41 days because nobody looked at what was in it:
#   settings.local.json  per-machine permission allowlist; embeds the dashboard
#                        feeds API bearer token, so committing it leaks a secret.
#   worktrees/           46M of LIVE registered git worktrees of this same repo
#                        (git worktree list). Both branches are pushed to origin,
#                        so ignoring them strands nothing.
/.claude/settings.local.json
/.claude/worktrees/
